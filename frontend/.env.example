# Public URL of THIS site (canonical URLs, sitemap, Open Graph, JSON-LD).
# Use your custom domain once you have one, e.g. https://debbarman.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the Render backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:10000

# Optional: shows a "mail me" fallback link in the contact section
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: shows the Resume button when set (e.g. /resume.pdf after adding it to /public)
NEXT_PUBLIC_RESUME_URL=

# Optional: Google Search Console "HTML tag" verification token (the content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
