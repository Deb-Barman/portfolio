# Render injects PORT itself. Locally it defaults to 10000.
PORT=10000

# Comma-separated list of sites allowed to call this API (no trailing slash).
# Add your custom domain AND your *.vercel.app URL.
ALLOWED_ORIGINS=http://localhost:3000,https://your-site.vercel.app

# Set to "true" to also allow Vercel preview deployments (https://anything.vercel.app)
ALLOW_VERCEL_PREVIEWS=false

# Email delivery through Resend (https://resend.com — free plan is plenty).
# Render's free plan blocks SMTP ports, so an HTTP email API is required.
RESEND_API_KEY=
# Where contact messages are delivered. With the default sender below this must be
# the same email address you signed up to Resend with.
CONTACT_TO_EMAIL=
CONTACT_FROM=Portfolio <onboarding@resend.dev>
