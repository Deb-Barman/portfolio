{
  "name": "deb-portfolio-api",
  "version": "1.0.0",
  "private": true,
  "description": "Contact API for Deb Barman's portfolio — Express + TypeScript, deploys on Render's free plan.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
